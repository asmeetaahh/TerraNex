# ==========================================================================
# TerraNex backend configuration
#
#   cp .env.example .env    then fill in the blanks.
#   .env is gitignored — NEVER commit real keys.
#
# Every value below has a working default except DATABASE_URL and the
# Supabase/Gemini credentials. You can boot the API with none of them set
# by leaving ENABLE_AUTH=false and AI_PROVIDER=mock.
# ==========================================================================

# ---- Application ---------------------------------------------------------
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ---- CORS ----------------------------------------------------------------
# Comma-separated exact origins. Never "*" — we send credentials.
# Add the deployed frontend origin here when you deploy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (Supabase Postgres) ---------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the *session pooler* URI (port 5432) and swap the scheme for psycopg:
#   postgresql+psycopg://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=

# ---- Supabase (auth + storage) ------------------------------------------
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # safe for the browser; frontend uses this
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — never expose to the frontend
SUPABASE_JWT_SECRET=                # fallback for HS256 projects; JWKS preferred
SUPABASE_STORAGE_BUCKET=crop-images

# ---- Auth ----------------------------------------------------------------
# false = every request is attributed to a seeded demo user, no token needed.
# This is the frontend's unblock switch: build every screen before wiring login.
ENABLE_AUTH=false

# ---- AI ------------------------------------------------------------------
# mock   = deterministic fixture responses. No key, no cost, no network.
#          Use for frontend dev, CI, and as a live demo-day kill switch.
# gemini = real Gemini calls (requires GEMINI_API_KEY).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_S=30
AI_TEMPERATURE=0.3                  # low = stable, reproducible demos

# ---- External data providers --------------------------------------------
# Open-Meteo is free and needs no API key — there is nothing to provision.
#
#   open_meteo = real global geocoding and real weather
#   simulated  = deterministic offline simulator (tests, demos, no network)
#
# The CODE default is `simulated`, so an unconfigured process never makes outbound
# calls. Real providers must be selected explicitly, as they are here.
#
# Soil and vegetation remain simulated in this phase regardless of these settings;
# every response says so via meta.mode.
WEATHER_PROVIDER=open_meteo
GEOCODING_PROVIDER=open_meteo

# If the live weather provider fails, fall back to the simulator and label the
# response mode=simulated. Set false to return mode=unavailable instead.
WEATHER_FALLBACK_TO_SIMULATION=true

PROVIDER_TIMEOUT_S=8                # per attempt
PROVIDER_MAX_RETRIES=2              # -> up to 3 attempts

# Wall-clock budget for one provider operation: every attempt and every backoff
# must fit inside it. Retries stop once it is spent, so no single request can be
# held up by an unresponsive upstream for longer than roughly this.
PROVIDER_DEADLINE_S=12
CACHE_TTL_WEATHER_S=1800            # 30 min
CACHE_TTL_SOIL_S=2592000            # 30 days — soil is effectively static
CACHE_TTL_VEGETATION_S=21600        # 6 h
CACHE_TTL_GEOCODE_S=86400           # 24 h

# ---- Crop image upload ---------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- Analysis ------------------------------------------------------------
ANALYSIS_CACHE_TTL_S=3600           # reuse a run with identical inputs within 1 h

# ---- Demo data -----------------------------------------------------------
SEED_DEMO_DATA=true                 # seed crop catalog + demo farms on startup
